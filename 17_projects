def display_header():
    """Display the program title."""

    print("=" * 70)
    print("Python Projects")
    print("=" * 70)


def display_projects(projects):
    """Display the list of beginner Python projects."""

    print()
    print("Recommended Beginner Projects")
    print("-" * 70)

    for index, project in enumerate(projects, start=1):
        print(f"{index:2}. {project}")


def main():
    """Main entry point of the program."""

    display_header()

    projects = [
        "Calculator",
        "Temperature Converter",
        "BMI Calculator",
        "Password Generator",
        "Random Password Manager",
        "To-Do List",
        "Student Management System",
        "Inventory Management System",
        "Contact Book",
        "Simple Banking System",
        "File Organizer",
        "CSV Reader",
        "JSON Reader",
        "Log File Analyzer",
        "System Information Viewer",
        "Network Ping Tool",
        "Port Scanner (Educational)",
        "Simple Web Scraper",
        "Weather Information Viewer",
        "Command Line Notes Application"
    ]

    display_projects(projects)

    print()
    print("=" * 70)
    print("Program Completed Successfully")
    print("=" * 70)


if __name__ == "__main__":
    main()
