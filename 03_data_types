"""
=========================================================
Project     : Python Fundamentals
Module      : 03 - Data Types
Author      : Kushendar
Repository  : python-fundamentals
Language    : Python 3

Description
-----------
This module introduces Python's built-in data types.

A data type defines the kind of value stored in a variable.
Python automatically determines the data type based on the
assigned value.

Learning Objectives
-------------------
1. Understand the purpose of data types.
2. Learn the most common built-in Python data types.
3. Display values together with their data types.
4. Understand when each data type should be used.

Data Types Covered
------------------
1. str        : Text
2. int        : Whole numbers
3. float      : Decimal numbers
4. bool       : True or False
5. list       : Ordered mutable collection
6. tuple      : Ordered immutable collection
7. set        : Unordered unique collection
8. dict       : Key-value collection
9. NoneType   : Represents no value

Expected Output
---------------
The program displays each value together with its Python
data type.

Coding Style
------------
This module follows clean code principles and PEP 8
recommendations for readability and maintainability.
=========================================================
"""


def main():
    """Main entry point of the program."""

    # =====================================================
    # String
    # =====================================================
    full_name = "Kushendar"

    # =====================================================
    # Integer
    # =====================================================
    age = 25

    # =====================================================
    # Float
    # =====================================================
    height = 170.5

    # =====================================================
    # Boolean
    # =====================================================
    is_learning = True

    # =====================================================
    # List
    # =====================================================
    programming_languages = [
        "Python",
        "Java",
        "C++"
    ]

    # =====================================================
    # Tuple
    # =====================================================
    server_ports = (
        22,
        80,
        443
    )

    # =====================================================
    # Set
    # =====================================================
    unique_numbers = {
        10,
        20,
        30
    }

    # =====================================================
    # Dictionary
    # =====================================================
    student = {
        "name": "Kushendar",
        "country": "Indonesia",
        "profession": "Student"
    }

    # =====================================================
    # NoneType
    # =====================================================
    future_job = None

    # =====================================================
    # Display Result
    # =====================================================

    print("=" * 70)
    print("Python Built-in Data Types")
    print("=" * 70)

    print(f"String      : {full_name}")
    print(f"Type        : {type(full_name).__name__}")
    print()

    print(f"Integer     : {age}")
    print(f"Type        : {type(age).__name__}")
    print()

    print(f"Float       : {height}")
    print(f"Type        : {type(height).__name__}")
    print()

    print(f"Boolean     : {is_learning}")
    print(f"Type        : {type(is_learning).__name__}")
    print()

    print(f"List        : {programming_languages}")
    print(f"Type        : {type(programming_languages).__name__}")
    print()

    print(f"Tuple       : {server_ports}")
    print(f"Type        : {type(server_ports).__name__}")
    print()

    print(f"Set         : {unique_numbers}")
    print(f"Type        : {type(unique_numbers).__name__}")
    print()

    print(f"Dictionary  : {student}")
    print(f"Type        : {type(student).__name__}")
    print()

    print(f"NoneType    : {future_job}")
    print(f"Type        : {type(future_job).__name__}")

    print("=" * 70)


if __name__ == "__main__":
    main()
