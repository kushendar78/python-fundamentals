def display_header():
    """Display the program title."""

    print("=" * 70)
    print("Python Functions")
    print("=" * 70)


def calculate_sum(number_a, number_b):
    """
    Return the sum of two numbers.

    Parameters
    ----------
    number_a : int
        First number.
    number_b : int
        Second number.

    Returns
    -------
    int
        Sum of the two numbers.
    """

    return number_a + number_b


def display_result(number_a, number_b, total):
    """Display the calculation result."""

    print()
    print("Calculation Result")
    print("-" * 70)
    print(f"First Number  : {number_a}")
    print(f"Second Number : {number_b}")
    print(f"Total         : {total}")


def main():
    """Main entry point of the program."""

    display_header()

    number_a = int(input("Enter first number  : "))
    number_b = int(input("Enter second number : "))

    total = calculate_sum(number_a, number_b)

    display_result(number_a, number_b, total)

    print()
    print("=" * 70)
    print("Program Completed Successfully")
    print("=" * 70)


if __name__ == "__main__":
    main()
